{
  "name": "nats-jetstream-studio",
  "productName": "NATS JetStream Studio",
  "version": "0.1.0",
  "description": "Desktop studio for NATS and JetStream: browse streams, consumers, subjects and messages.",
  "main": "./out/main/index.js",
  "desktopName": "nats-jetstream-studio.desktop",
  "author": "NATS JetStream Studio contributors",
  "license": "Apache-2.0",
  "keywords": [
    "nats",
    "jetstream",
    "nats-gui",
    "nats-client",
    "electron",
    "message-queue"
  ],
  "homepage": "https://github.com/hardik-id/nats-jetstream-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/hardik-id/nats-jetstream-studio.git"
  },
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:web": "vite build --config vite.web.config.ts && node scripts/build-server.mjs",
    "serve": "node dist/server/index.cjs",
    "test": "vitest run",
    "test:core": "vitest run --project core",
    "test:ui": "vitest run --project ui",
    "test:e2e": "npm run build && npm run build:web && playwright test",
    "nats": "node scripts/nats-dev.mjs",
    "seed": "node scripts/seed.mjs",
    "traffic": "node scripts/seed.mjs --traffic"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/obj": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@nats-io/jwt": "^0.0.10-5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jose": "^6.2.17",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.73.0",
    "prettier": "^3.9.10",
    "protobufjs": "^8.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0",
    "ws": "^8.23.0",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
