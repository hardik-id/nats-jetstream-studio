---
import Screenshot from './Screenshot.astro'
import { url } from '../../lib/url'

interface Props {
  path: string
  title: string
  text: string
  shot: { name: string }
}
const { path, title, text, shot } = Astro.props
---

<article class="card">
  <Screenshot name={shot.name} href={url(path)} />
  <h2><a href={url(path)}>{title}</a></h2>
  <p>{text}</p>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  h2 {
    font-size: 1.2rem;
    margin: 0;
  }
  p {
    margin: 0;
    color: var(--muted);
  }
</style>
