---
// A screenshot in two themes. Both files are in the page; CSS shows the one that matches the theme
// set on <html data-theme> and hides the other with display:none. Layout always sets data-theme
// (dark by default, before first paint), so the hidden variant is never needed on load. Both images
// are lazy: a browser does not fetch a lazy image that is display:none, so only the visible one loads.
// The hero stays lazy with fetchpriority=high on purpose: an eager image would also fetch the
// display:none variant (and which one is hidden depends on a theme the user may change by script).
// Size and alt text come from public/media/manifest.json. Each image is a plain link to the full
// file, so "open larger" works without JS. With `href`, the image links there instead (cards).
import { url } from '../../lib/url'
import manifest from '../../../public/media/manifest.json'

interface Props {
  /** File stem under public/media, for example "features-streams". */
  name: string
  /** Hero image: ask the browser to fetch it early. */
  hero?: boolean
  /** Link target instead of the full-size image; the image then has no alt (a titled link sits next to it). */
  href?: string
  /** First card on a page: raise its fetch priority (it is the largest element above the fold). */
  priority?: boolean
}
const { name, hero = false, href, priority = false } = Astro.props
const CARD_WIDTH = 640 // scripts/make-card-images.mjs
const themes = ['dark', 'light'] as const
const files = themes.map((t) => {
  const file = `${name}-${t}.webp`
  const entry = manifest.files.find((f) => f.file === file)
  if (!entry) throw new Error(`public/media/manifest.json has no entry for ${file}`)
  return { t, entry }
})
---

<figure class="shot">
  {
    files.map(({ t, entry }) => (
      <a
        class={`shot-link ${t}`}
        href={href ?? url(`/media/${entry.file}`)}
        target={href ? undefined : '_blank'}
        rel={href ? undefined : 'noopener'}
        title={href ? undefined : 'Open the full-size image'}
        aria-hidden={href ? 'true' : undefined}
        tabindex={href ? -1 : undefined}
      >
        <img
          src={url(href ? `/media/cards/${entry.file}` : `/media/${entry.file}`)}
          alt={href ? '' : entry.alt}
          width={href ? CARD_WIDTH : entry.width}
          height={href ? Math.round((CARD_WIDTH * entry.height) / entry.width) : entry.height}
          loading="lazy"
          decoding="async"
          fetchpriority={hero || priority ? 'high' : undefined}
        />
        {!href && <span class="sr-only"> (opens the full-size image in a new tab)</span>}
      </a>
    ))
  }
</figure>

<style>
  .shot {
    margin: 0;
  }
  .shot-link {
    display: block;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--panel);
    line-height: 0;
  }
  .shot-link:hover {
    border-color: var(--accent-text);
  }
  img {
    width: 100%;
    height: auto;
    display: block;
  }
  :global([data-theme='dark']) .shot-link.light,
  :global([data-theme='light']) .shot-link.dark {
    display: none;
  }
</style>
