---
import { url, repo } from '../../lib/url'
---

<section class="closing container" aria-labelledby="closing-title">
  <h2 id="closing-title">Try it on your own NATS server</h2>
  <p class="lede">Free to use. Open source.</p>
  <div class="actions">
    <a id="closing-download" class="btn primary" href={url('/download/')}>Download</a>
    <a class="btn" href={repo}>Star on GitHub</a>
  </div>
</section>

<script is:inline>
  ;(function () {
    var h = document.getElementById('hero-download')
    var c = document.getElementById('closing-download')
    if (h && c) {
      c.textContent = h.textContent
      c.setAttribute('href', h.getAttribute('href'))
    }
  })()
</script>

<style>
  .closing {
    padding-block: 3rem 4rem;
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
