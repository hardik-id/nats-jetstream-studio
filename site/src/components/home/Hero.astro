---
import { url } from '../../lib/url'
import { download, features } from '../../lib/site-map'

const poster = url('/media/home-still.webp')
const alt = 'Tour of the studio: overview, streams, the messages of ORDERS with a message open, and consumers'
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="copy">
    <h1 id="hero-title">NATS JetStream Studio</h1>
    <p class="lede">A free GUI and desktop client for NATS and JetStream.</p>
    <div class="actions">
      <a id="hero-download" class="btn primary" href={url(download.path)}>Download</a>
      <a class="btn" href={url(features.path)}>See features</a>
    </div>
    <p class="note">Free and open source. Windows, macOS and Linux, or in a browser.</p>
  </div>
  <div class="media">
    <video
      id="hero-video"
      class="clip"
      width="1100"
      height="660"
      poster={poster}
      preload="none"
      controls
      aria-label={alt}
    >
      <source src={url('/media/home.mp4')} type="video/mp4" />
    </video>
    <img class="still" src={poster} width="1100" height="660" alt={alt} />
  </div>
</section>

<script is:inline define:vars={{ downloadHref: url(download.path) }}>
  ;(function () {
    var a = document.getElementById('hero-download')
    var ua = navigator.userAgent || ''
    var p = navigator.platform || ''
    var os = null
    if (/Android|iPhone|iPad|iPod/i.test(ua)) os = null
    else if (/Win/i.test(p) || /Windows/i.test(ua)) os = ['Windows', 'windows']
    else if (/Mac/i.test(p) || /Mac OS X/i.test(ua)) os = ['macOS', 'macos']
    else if (/Linux|X11|CrOS/i.test(p + ua)) os = ['Linux', 'linux']
    if (a && os) {
      a.textContent = 'Download for ' + os[0]
      a.setAttribute('href', downloadHref + '#' + os[1])
    }
    var v = document.getElementById('hero-video')
    if (v && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.removeAttribute('controls')
      v.muted = true
      v.loop = true
      v.setAttribute('playsinline', '')
      v.preload = 'auto'
      var r = v.play()
      if (r && r.catch)
        r.catch(function () {
          v.setAttribute('controls', '')
        })
    }
  })()
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2.5rem;
    align-items: center;
    padding-block: 2rem 2.5rem;
  }
  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    margin-bottom: 1rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .note {
    color: var(--faint);
    font-size: 0.9rem;
    margin-top: 1rem;
  }
  .media video,
  .media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1100 / 660;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
  }
  .still {
    display: none !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .clip {
      display: none !important;
    }
    .still {
      display: block !important;
    }
  }
  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
