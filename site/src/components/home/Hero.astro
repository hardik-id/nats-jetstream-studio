---
import { url } from '../../lib/url'
import { download, features } from '../../lib/site-map'

const poster = url('/media/home-still.webp')
const alt = 'Tour of the studio: overview, streams, the messages of ORDERS with a message open, and consumers'
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="copy">
    <h1 id="hero-title">NATS JetStream Studio</h1>
    <p class="lede">A free GUI and desktop client for NATS and JetStream.</p>
    <div class="actions">
      <a id="hero-download" class="btn primary" href={url(download.path)}>Download</a>
      <a class="btn" href={url(features.path)}>See features</a>
    </div>
    <p class="note">Free and open source. Windows, macOS and Linux, or in a browser.</p>
  </div>
  <div class="media">
    <video
      id="hero-video"
      class="clip"
      width="1100"
      height="660"
      poster={poster}
      preload="none"
      controls
      aria-label={alt}
    >
      <source src={url('/media/home.mp4')} type="video/mp4" />
    </video>
    <button id="hero-toggle" class="toggle" type="button" hidden aria-label="Pause demo">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path id="hero-toggle-icon" d="M6 5h4v14H6zM14 5h4v14h-4z"></path>
      </svg>
    </button>
    <img class="still" src={poster} width="1100" height="660" alt={alt} />
  </div>
</section>

<script is:inline define:vars={{ downloadHref: url(download.path) }}>
  ;(function () {
    var a = document.getElementById('hero-download')
    var ua = navigator.userAgent || ''
    var p = navigator.platform || ''
    var os = null
    var touchMac = p === 'MacIntel' && navigator.maxTouchPoints > 1
    if (/Android|iPhone|iPad|iPod/i.test(ua) || touchMac) os = null
    else if (/Win/i.test(p) || /Windows/i.test(ua)) os = ['Windows', 'windows']
    else if (/Mac/i.test(p) || /Mac OS X/i.test(ua)) os = ['macOS', 'macos']
    else if (/Linux|X11|CrOS/i.test(p + ua)) os = ['Linux', 'linux']
    if (a && os) {
      a.textContent = 'Download for ' + os[0]
      a.setAttribute('href', downloadHref + '#' + os[1])
    }
    var v = document.getElementById('hero-video')
    var t = document.getElementById('hero-toggle')
    var icon = document.getElementById('hero-toggle-icon')
    if (!v || !t) return
    var mq = window.matchMedia('(prefers-reduced-motion: reduce)')
    var PAUSE = 'M6 5h4v14H6zM14 5h4v14h-4z'
    var PLAY = 'M7 4l13 8-13 8z'
    function sync() {
      var playing = !v.paused
      t.setAttribute('aria-label', playing ? 'Pause demo' : 'Play demo')
      icon.setAttribute('d', playing ? PAUSE : PLAY)
    }
    v.addEventListener('play', sync)
    v.addEventListener('pause', sync)
    t.addEventListener('click', function () {
      if (v.paused) v.play()
      else v.pause()
    })
    function apply() {
      if (mq.matches) {
        v.pause()
        t.hidden = true
        return
      }
      v.removeAttribute('controls')
      v.muted = true
      v.loop = true
      v.setAttribute('playsinline', '')
      v.preload = 'auto'
      t.hidden = false
      var r = v.play()
      if (r && r.catch)
        r.catch(function () {
          t.hidden = true
          v.setAttribute('controls', '')
        })
    }
    apply()
    if (mq.addEventListener) mq.addEventListener('change', apply)
  })()
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2.5rem;
    align-items: center;
    padding-block: 2rem 2.5rem;
  }
  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    margin-bottom: 1rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .note {
    color: var(--faint);
    font-size: 0.9rem;
    margin-top: 1rem;
  }
  .media video,
  .media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1100 / 660;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
  }
  .media {
    position: relative;
  }
  .toggle {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--fg);
    cursor: pointer;
  }
  .toggle[hidden] {
    display: none;
  }
  .toggle:hover {
    background: var(--raised);
  }
  .still {
    display: none !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .clip {
      display: none !important;
    }
    .still {
      display: block !important;
    }
  }
  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
