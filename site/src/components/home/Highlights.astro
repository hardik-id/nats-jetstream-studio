---
import { url } from '../../lib/url'
import { featurePages } from '../../lib/site-map'

// Titles and paths come from site-map.ts; only the sentence and icon live here.
const copy: Record<string, { label?: string; text: string; icon: string }> = {
  '/features/message-browser/': {
    text: 'Read stream messages without creating a consumer, then filter and export them.',
    icon: 'M4 5h16v4H4zM4 11h16v4H4zM4 17h10v2H4z'
  },
  '/features/trace/': {
    text: 'Follow one request across subjects, streams and consumers, as a timeline, lanes or a graph.',
    icon: 'M5 6a2 2 0 1 0 0 .01zM19 18a2 2 0 1 0 0 .01zM12 6a2 2 0 1 0 0 .01zM7 6h3M14 6h2a3 3 0 0 1 3 3v7'
  },
  '/features/consumers/': {
    label: 'Consumer health',
    text: 'See lag, ack pending and redeliveries, with flags for consumers that need a look.',
    icon: 'M3 12h4l3-8 4 16 3-8h4'
  },
  '/features/live-tail-and-publish/': {
    text: 'Watch any subject as it happens, publish a message or send a request and read the reply.',
    icon: 'M5 4l14 8-14 8 3-8z'
  },
  '/features/connections/': {
    label: 'Several connections',
    text: 'Keep many servers and environments side by side, with all the common auth types.',
    icon: 'M9 7V3m6 4V3M7 7h10v5a5 5 0 0 1-10 0zM12 17v4'
  },
  '/features/kv-and-object-store/': {
    text: 'Browse and watch keys, upload and download objects.',
    icon: 'M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zm0 0v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3'
  },
  '/features/monitoring-and-alerts/': {
    label: 'Monitoring',
    text: 'Charts, alert rules and a view of the cluster.',
    icon: 'M4 20V10m6 10V4m6 16v-7m4 7H3'
  }
}

const items = Object.entries(copy).map(([path, c]) => {
  const page = featurePages.find((p) => p.path === path)
  if (!page) throw new Error(`Home highlight: no site-map page for ${path}`)
  return { path, title: c.label ?? page.title, text: c.text, icon: c.icon }
})
---

<section class="highlights container" aria-labelledby="highlights-title">
  <h2 id="highlights-title">What you get</h2>
  <ul>
    {
      items.map((i) => (
        <li>
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={i.icon} />
          </svg>
          <h3>
            <a href={url(i.path)}>{i.title}</a>
          </h3>
          <p>{i.text}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .highlights {
    padding-block: 2.5rem;
  }
  ul {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }
  li {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 1.25rem;
  }
  svg {
    color: var(--accent-text);
  }
  h3 {
    font-size: 1.1rem;
    margin: 0.75rem 0 0.4rem;
  }
  h3 a {
    color: var(--fg);
  }
  p {
    margin: 0;
    color: var(--muted);
  }
</style>
