---
import Layout from '../layouts/Layout.astro'
import { getReleases, releasesPageUrl, formatDate } from '../lib/releases'
import { url } from '../lib/url'

const { ok, releases } = await getReleases()
---

<Layout>
  <link slot="head" rel="alternate" type="application/rss+xml" title="NATS JetStream Studio releases" href={url('/changelog/rss.xml')} />
  <div class="container page">
    <h1>Changelog</h1>
    <p class="lede">What changed in each version. <a href={url('/changelog/rss.xml')}>RSS feed</a></p>
    {
      !ok ? (
        <p>
          The release list could not be loaded. See all versions on the <a href={releasesPageUrl}>releases page</a>.
        </p>
      ) : releases.length === 0 ? (
        <p>No releases yet. Check the <a href={releasesPageUrl}>releases page</a> later.</p>
      ) : (
        releases.map((r) => (
          <article class="entry" id={`v${r.version}`}>
            <h2>
              <a href={`#v${r.version}`}>Version {r.version}</a>
            </h2>
            <p class="meta">
              <time datetime={r.date}>{formatDate(r.date)}</time> · <a href={r.url}>Downloads</a>
            </p>
            <div class="notes" set:html={r.notesHtml} />
          </article>
        ))
      )
    }
  </div>
</Layout>

<style>
  .entry {
    border-top: 1px solid var(--line);
    padding-block: 1.5rem;
    max-width: 48rem;
  }
  .entry h2 {
    margin: 0;
    font-size: 1.5rem;
  }
  .entry h2 a {
    color: inherit;
    text-decoration: none;
  }
  .meta {
    margin: 0.25rem 0 0.75rem;
    color: var(--muted);
  }
  .notes :global(h1),
  .notes :global(h2),
  .notes :global(h3) {
    font-size: 1.1rem;
    margin: 1rem 0 0.4rem;
  }
  .notes :global(p),
  .notes :global(ul),
  .notes :global(ol) {
    margin: 0.5rem 0;
  }
  .notes :global(pre) {
    overflow-x: auto;
    background: var(--code);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.75rem;
  }
</style>
