---
import Layout from '../layouts/Layout.astro'
import PlatformCard from '../components/download/PlatformCard.astro'
import FirstRun from '../components/download/FirstRun.astro'
import { getReleases, releasesPageUrl, formatDate } from '../lib/releases'
import { url, repo } from '../lib/url'

const { ok, releases } = await getReleases()
const latest = ok ? releases[0] : undefined
const find = (re: RegExp) => latest?.assets.find((a) => re.test(a.name))
const exe = find(/\.exe$/i)
const dmg = find(/\.dmg$/i)
const appImage = find(/\.AppImage$/i)
const deb = find(/\.deb$/i)
const fallback = latest?.url ?? releasesPageUrl
---

<Layout>
  <div class="container page">
    <h1>Download</h1>
    {
      latest ? (
        <p class="lede">
          Version {latest.version}, released {formatDate(latest.date)}. <a href={latest.url}>Release notes</a>
        </p>
      ) : (
        <p class="lede">
          Get the installer for your system from the <a href={releasesPageUrl}>releases page</a>.
        </p>
      )
    }

    <div class="cards">
      <PlatformCard
        os="windows"
        title="Windows"
        note="Windows installer (.exe)."
        files={[{ label: '.exe', asset: exe }]}
        fallbackUrl={fallback}
      >
        <FirstRun title="First run: SmartScreen" issue={`${repo}/issues/17`} issueLabel="issue #17">
          <p>The installer is not code-signed yet, so Windows says "Windows protected your PC".</p>
          <p>Click <strong>More info</strong>, then <strong>Run anyway</strong>.</p>
        </FirstRun>
      </PlatformCard>

      <PlatformCard
        os="mac"
        title="macOS"
        note="One disk image (.dmg) for Apple silicon and Intel."
        files={[{ label: '.dmg', asset: dmg }]}
        fallbackUrl={fallback}
      >
        <FirstRun title="First run: Gatekeeper" issue={`${repo}/issues/18`} issueLabel="issue #18">
          <p>The app is not code-signed yet, so macOS says it "cannot be verified" or "is damaged".</p>
          <p>
            Open <strong>System Settings &gt; Privacy &amp; Security</strong> and click <strong>Open Anyway</strong>, or
            run this once:
          </p>
          <p><code>xattr -cr "/Applications/NATS JetStream Studio.app"</code></p>
        </FirstRun>
      </PlatformCard>

      <PlatformCard
        os="linux"
        title="Linux"
        note="AppImage (make it executable and run it) or a .deb package. No warning on first run."
        files={[
          { label: '.AppImage', asset: appImage },
          { label: '.deb', asset: deb }
        ]}
        fallbackUrl={fallback}
      />
    </div>

    <p class="updates">
      There is no automatic update yet. Download new versions from this page. Older versions are on the{' '}
      <a href={releasesPageUrl}>releases page</a>, and the <a href={url('/changelog/')}>changelog</a> lists what changed.
    </p>

    <div class="more">
      <section class="box">
        <h2>Run it in a browser</h2>
        <p>Nothing to install: start web mode and open the studio in your browser.</p>
        <p><a href={url('/docs/web-mode/')}>Read the web mode guide</a></p>
      </section>
      <section class="box">
        <h2>Build from source</h2>
        <p>
          Prefer to build it yourself? See <a href={`${repo}/blob/main/CONTRIBUTING.md`}>CONTRIBUTING.md</a> on GitHub.
        </p>
      </section>
    </div>
  </div>
</Layout>

<script is:inline>
  // Highlight the card for the visitor's system. The page works the same without this.
  ;(function () {
    var ua = navigator.userAgent || ''
    var p = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || ''
    var s = ua + ' ' + p
    var os = /Android|iPhone|iPad/.test(s) ? '' : /Win/i.test(s) ? 'windows' : /Mac/i.test(s) ? 'mac' : /Linux|X11/i.test(s) ? 'linux' : ''
    if (!os) return
    var card = document.querySelector('.card[data-os="' + os + '"]')
    if (!card) return
    card.classList.add('is-current')
    var tag = card.querySelector('.here')
    if (tag) tag.hidden = false
  })()
</script>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: 1rem;
    align-items: start;
  }
  .updates {
    color: var(--muted);
    margin: 1.5rem 0;
  }
  .more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: 1rem;
  }
  .box {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.25rem;
  }
  .box h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }
  .box p {
    margin: 0.3rem 0;
  }
</style>
