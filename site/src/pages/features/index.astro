---
import Layout from '../../layouts/Layout.astro'
import FeatureCard from '../../components/features/FeatureCard.astro'
import { features, featurePages } from '../../lib/site-map'
import { featureContent, type FeatureSlug } from '../../components/features/data'

const cards = featurePages.map((p) => {
  const slug = p.path.split('/').filter(Boolean)[1]
  if (!(slug in featureContent)) throw new Error(`No feature content for ${p.path}`)
  const f = featureContent[slug as FeatureSlug]
  return { path: p.path, title: p.title, text: f.card, shot: f.shot }
})
---

<Layout>
  <div class="container page">
    <h1>{features.title}</h1>
    <p class="lede">
      Everything NATS JetStream Studio can do, in eight areas. Each page shows the real app.
    </p>
    <div class="grid">
      {cards.map((c) => <FeatureCard {...c} />)}
    </div>
  </div>
</Layout>

<style>
  .grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
  }
</style>
